{
  "name": "@riesvile/nospace",
  "version": "0.1.0",
  "description": "Automatic word spacing for your text input, with a headless editing engine and optional Jev/Luna backend.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/riesvile/nospace.git" },
  "engines": { "node": ">=22.12" },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./dom": { "types": "./dist/dom.d.ts", "import": "./dist/dom.js" },
    "./server": { "types": "./dist/server/index.d.ts", "browser": null, "import": "./dist/server/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE", "NOTICE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-license.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "verify": "npm run check && npm test && npm run build && node scripts/verify-package.mjs"
  },
  "devDependencies": { "typescript": "^5.9.0", "vitest": "^4.1.0", "vite": "^7.3.0", "jsdom": "^26.1.0" }
}
